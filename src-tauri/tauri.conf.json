{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logd",
  "version": "0.1.0",
  "identifier": "dev.logd.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Logd",
        "width": 1440,
        "height": 880,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": { "effects": ["acrylic"] }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
